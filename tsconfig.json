{
  "compilerOptions": {
    "outDir": "lib",
    "rootDir": "./src",
    "target": "es6",
    "module": "node16",
    "moduleResolution": "node16",
    "isolatedModules": true,
    "declaration": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "strict": true
  },
  "include": [
    "./src/**/*"
  ],
  "exclude": [
    "./src/stories/**/*",
    "node_modules",
    "build",
    "scripts",
    "acceptance-tests",
    "webpack",
    "jest",
    "src/setupTests.ts"
  ]
}
